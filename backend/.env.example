PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/easyparking?replicaSet=rs0
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://easy-parking-management.vercel.app
# Set only when deployed behind a trusted reverse proxy; use its exact hop count.
# TRUST_PROXY_HOPS=1
